<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F7F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#FAFCF9" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#142820" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#21392E" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#294538" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#DDEBE1" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#A5BDAE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#126343" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0C5136" />
    <SolidColorBrush x:Key="BrandMintBrush" Color="#BDFFCC" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#E8F4EB" />
    <SolidColorBrush x:Key="TextBrush" Color="#182B23" />
    <SolidColorBrush x:Key="MutedBrush" Color="#4D6558" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D6E0D8" />
    <SolidColorBrush x:Key="SoftBorderBrush" Color="#E8EEE9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A32C3B" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBECEE" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#8A5B11" />

    <sys:String x:Key="VaultGlyph">&#xE8F1;</sys:String>
    <sys:String x:Key="StarGlyph">&#xE734;</sys:String>
    <sys:String x:Key="StarFilledGlyph">&#xE735;</sys:String>
    <sys:String x:Key="RecentGlyph">&#xE823;</sys:String>
    <sys:String x:Key="FolderGlyph">&#xE8B7;</sys:String>
    <sys:String x:Key="KeyGlyph">&#xE8D7;</sys:String>
    <sys:String x:Key="BackupGlyph">&#xE896;</sys:String>
    <sys:String x:Key="SyncGlyph">&#xE895;</sys:String>
    <sys:String x:Key="SettingsGlyph">&#xE713;</sys:String>
    <sys:String x:Key="SearchGlyph">&#xE721;</sys:String>
    <sys:String x:Key="CloseGlyph">&#xE711;</sys:String>
    <sys:String x:Key="AddGlyph">&#xE710;</sys:String>
    <sys:String x:Key="LockGlyph">&#xE72E;</sys:String>
    <sys:String x:Key="EditGlyph">&#xE70F;</sys:String>
    <sys:String x:Key="DeleteGlyph">&#xE74D;</sys:String>
    <sys:String x:Key="CopyGlyph">&#xE8C8;</sys:String>
    <sys:String x:Key="ShowGlyph">&#xE890;</sys:String>
    <sys:String x:Key="HideGlyph">&#xE7B3;</sys:String>
    <sys:String x:Key="ShieldGlyph">&#xEA18;</sys:String>
    <sys:String x:Key="HelloGlyph">&#xE8D4;</sys:String>
    <sys:String x:Key="UsbGlyph">&#xE88E;</sys:String>
    <sys:String x:Key="NetworkGlyph">&#xE701;</sys:String>

    <DrawingImage x:Key="ScanFaceMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <GeometryDrawing Geometry="M9,3 H5 Q3,3 3,5 V9 M15,3 H19 Q21,3 21,5 V9 M21,15 V19 Q21,21 19,21 H15 M9,21 H5 Q3,21 3,19 V15 M8,12 H16">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#142820" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#126343" Geometry="M12,7 L17,12 12,17 7,12Z" />
                <GeometryDrawing Brush="#BDFFCC" Geometry="M12,10 L14,12 12,14 10,12Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Language" Value="pt-BR" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="PickerFrame" Background="{TemplateBinding Background}" BorderThickness="1"
                                            BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                                        <Path Data="M0,0 L4,4 8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.35"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,11,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PickerFrame" Property="Background" Value="{StaticResource AccentSurfaceBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="0,0,25,0" IsHitTestVisible="False" ClipToBounds="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </Grid>
                        <Border x:Name="PickerFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="3" Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PickerFocus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldBase" TargetType="Control">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="9,5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BrandIcon" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource BrandMintBrush}" />
    </Style>

    <Style x:Key="AuthFrame" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{StaticResource BackgroundBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.59*" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}">
                            <Grid Margin="36,30">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Style="{StaticResource BrandIcon}">
                                        <Image Source="{StaticResource ScanFaceMark}" Width="25" Height="25" />
                                    </Border>
                                    <TextBlock Text="ScanFace" FontSize="22" FontWeight="SemiBold" Margin="11,0,0,0"
                                               Foreground="{StaticResource SurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel MaxWidth="295" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,40,0,0">
                                    <Border Width="98" Height="98" Padding="15" CornerRadius="24" HorizontalAlignment="Left"
                                            Background="{StaticResource SidebarHoverBrush}" BorderBrush="{StaticResource SidebarSelectedBrush}" BorderThickness="1">
                                        <Border Style="{StaticResource BrandIcon}" Width="60" Height="60" CornerRadius="16">
                                            <Image Source="{StaticResource ScanFaceMark}" Width="42" Height="42" />
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Seu cofre pessoal" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource SurfaceBrush}"
                                               TextWrapping="Wrap" Margin="0,21,0,8" />
                                    <TextBlock Text="Suas credenciais ficam cifradas neste dispositivo." Foreground="{StaticResource SidebarMutedBrush}"
                                               TextWrapping="Wrap" FontSize="15" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                                <Border Style="{StaticResource Card}" Padding="30,25" MaxWidth="456" Margin="30,20"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <ContentPresenter />
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormStatus" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,9,0,2" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Foreground" Value="#A4B7A9" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="20" Background="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" CornerRadius="3" Margin="3,1"
                                                        Background="{TemplateBinding Background}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Margin" Value="2,1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
