<Window x:Class="ScanFace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="ScanFace"
        Width="1260" Height="790" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/ScanFace;component/Assets/scanface.ico"
        PreviewKeyDown="OnUserActivity" PreviewMouseDown="OnUserActivity" PreviewMouseWheel="OnUserActivity">
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
