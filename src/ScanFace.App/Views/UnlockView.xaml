<UserControl x:Class="ScanFace.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:ScanFace.App.Presentation">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Grid.Column="1" Width="480" Style="{StaticResource Card}" VerticalAlignment="Center" Margin="24">
            <StackPanel>
                <Border Background="White" CornerRadius="10" Padding="12" HorizontalAlignment="Center">
                    <Image Source="/Assets/scanface-logo.png" Width="250" Stretch="Uniform" />
                </Border>
                <TextBlock Text="Seu cofre está bloqueado" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" />
                <TextBlock Text="Confirme sua identidade para continuar."
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,22" />

                <Button Command="{Binding UnlockWithHelloCommand}" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding HelloEnabled, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◉" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Entrar com Windows Hello" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Visibility="{Binding HelloEnabled, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ou use a senha mestra" Foreground="{StaticResource MutedBrush}" Margin="12,0" />
                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Senha mestra" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding MasterPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10" />
                <Button Content="Desbloquear com senha" Command="{Binding UnlockWithPasswordCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
