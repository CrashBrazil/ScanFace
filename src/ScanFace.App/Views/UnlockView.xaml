<UserControl x:Class="ScanFace.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScanFace.App.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="ScannerArt" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Viewbox MaxWidth="294" MaxHeight="294" StretchDirection="DownOnly" IsHitTestVisible="False">
                            <Grid Width="294" Height="294">
                                <Ellipse Stroke="#355345" StrokeThickness="1" StrokeDashArray="1 6" Margin="4" />
                                <Ellipse Stroke="#2D493C" StrokeThickness="1" Margin="23" />
                                <Ellipse Margin="37" Stroke="#3A5C49" StrokeThickness="1">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#284F3B" Offset="0" />
                                            <GradientStop Color="#172E25" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path x:Name="Brackets" Stroke="#94C7A2" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M59,100 V81 Q59,61 79,61 H99 M195,61 H215 Q235,61 235,81 V100 M235,194 V213 Q235,233 215,233 H195 M99,233 H79 Q59,233 59,213 V194" />
                                <Ellipse x:Name="Pulse" Margin="28" Stroke="{StaticResource BrandMintBrush}" StrokeThickness="1.5"
                                         Opacity="0" />
                                <Path x:Name="Face" Stroke="#A6D4AE" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M147,96 C118,96 112,119 112,140 C112,164 126,188 147,190 C168,188 182,164 182,140 C182,119 176,96 147,96 Z M105,207 C119,191 175,191 189,207 M124,139 Q130,134 136,139 M158,139 Q164,134 170,139 M146,142 L142,154 H150 M136,168 Q147,174 158,168" />
                                <TextBlock x:Name="Lock" Style="{StaticResource Glyph}" Text="{StaticResource LockGlyph}"
                                           Foreground="{StaticResource BrandMintBrush}" FontSize="52" Visibility="Collapsed" />
                                <Grid ClipToBounds="True" Width="184" Height="178">
                                    <Border x:Name="Sweep" Height="2" Width="172" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Border.Background>
                                            <LinearGradientBrush>
                                                <GradientStop Color="#00BDFFCC" Offset="0" />
                                                <GradientStop Color="#E3FFEB" Offset="0.5" />
                                                <GradientStop Color="#00BDFFCC" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Path x:Name="Success" Data="M114,148 L138,171 181,122" Stroke="{StaticResource BrandMintBrush}"
                                      StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed" />
                                <Path Stroke="#6B9C7E" StrokeThickness="1" Data="M147,18 V28 M147,266 V276 M18,147 H28 M266,147 H276" />
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingHello}">
                                <Setter TargetName="Brackets" Property="Stroke" Value="{StaticResource BrandMintBrush}" />
                                <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingHello}" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Scanning">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-70" To="70" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                             From="0.18" To="0.75" Duration="0:0:1.25" AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="Scanning" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.Confirmed}">
                                <Setter TargetName="Brackets" Property="Stroke" Value="{StaticResource BrandMintBrush}" />
                                <Setter TargetName="Face" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Lock" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Success" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Pulse" Property="Opacity" Value="0.65" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnlockNotice" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Setter Property="Margin" Value="0,0,0,13" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.Attention}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="36,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource BrandIcon}">
                        <Image Source="{StaticResource ScanFaceMark}" Width="25" Height="25" />
                    </Border>
                    <TextBlock Text="ScanFace" FontSize="22" FontWeight="SemiBold" Margin="11,0,0,0"
                               Foreground="{StaticResource SurfaceBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="1">
                        <ContentControl Style="{StaticResource ScannerArt}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding SecurityStatus}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{StaticResource SurfaceBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource ShieldGlyph}" Foreground="{StaticResource BrandMintBrush}"
                               FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Credenciais cifradas neste dispositivo" Foreground="{StaticResource SidebarTextBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Border Style="{StaticResource Card}" Padding="34,30" MaxWidth="466" Margin="27,20"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="43" Height="43" CornerRadius="10" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource LockGlyph}" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                        </Border>

                        <TextBlock Text="Desbloquear cofre" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource UnlockNotice}" Margin="0,4,0,14" />

                        <StackPanel Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Confirme sua identidade com o Windows Hello." Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,15" />

                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="13,11" Margin="0,0,0,13" MinHeight="58">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource HelloGlyph}" FontSize="16"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Se o reconhecimento facial estiver configurado, olhe para a câmera quando o Windows pedir." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingHello}">
                                                        <Setter Property="Text" Value="Siga as instruções na janela de segurança do Windows." />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.Confirmed}">
                                                        <Setter Property="Text" Value="Abrindo seu cofre." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button x:Name="HelloButton" Command="{Binding UnlockWithHelloCommand}" IsDefault="True" MinHeight="44"
                                    AutomationProperties.Name="Verificar com Windows Hello">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Verificar com Windows Hello" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingHello}">
                                                <Setter Property="Content" Value="Aguardando confirmação…" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.Confirmed}">
                                                <Setter Property="Content" Value="Identidade confirmada" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="0,6,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Setter Property="Content" Value="Usar senha mestra" />
                                        <Setter Property="Command" Value="{Binding UsePasswordCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingHello}">
                                                <Setter Property="Content" Value="Cancelar verificação" />
                                                <Setter Property="Command" Value="{Binding CancelHelloCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Digite a senha mestra para acessar suas credenciais."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,17" />
                            <Label x:Name="MasterPasswordLabel" Content="Senha mestra" Style="{StaticResource FormLabel}"
                                   Target="{Binding ElementName=MasterPasswordInput}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="MasterPasswordInput"
                                         AutomationProperties.LabeledBy="{Binding ElementName=MasterPasswordLabel}"
                                         PasswordChanged="MasterPasswordChanged" IsVisibleChanged="OnPasswordInputChanged"
                                         IsEnabledChanged="OnPasswordInputChanged">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <Button Click="SubmitPassword" IsEnabled="{Binding CanSubmitPassword}" IsDefault="True" MinHeight="44" Margin="0,13,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Desbloquear com senha" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:UnlockStage.VerifyingPassword}">
                                                <Setter Property="Content" Value="Validando senha…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Voltar ao Windows Hello" Command="{Binding UseHelloCommand}" Style="{StaticResource QuietButton}"
                                    Click="OnReturnToHello" Margin="0,6,0,0"
                                    Visibility="{Binding HelloEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Margin="0,15,0,0" Visibility="{Binding HelloEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Background="{StaticResource SoftBorderBrush}" Height="1" Margin="0,0,0,11" />
                                <TextBlock Text="{Binding HelloHint}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                <Button Content="Opções de entrada do Windows" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                        MinHeight="32" Padding="0,5" Click="OpenWindowsSignIn" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
