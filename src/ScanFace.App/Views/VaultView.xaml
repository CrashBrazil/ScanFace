<UserControl x:Class="ScanFace.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScanFace.App.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

        <CollectionViewSource x:Key="NavigationGroups" Source="{Binding FolderFilters}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="9,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BrandMintBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BrandMintBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntryItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="59" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="9,8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BackgroundBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#CBDDCF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,22,14,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,24">
                    <Border Style="{StaticResource BrandIcon}">
                        <Image Source="{StaticResource ScanFaceMark}" Width="25" Height="25" />
                    </Border>
                    <TextBlock Text="ScanFace" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource SurfaceBrush}" VerticalAlignment="Center" Margin="10,0,0,1" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                <StackPanel>
                <ListBox ItemsSource="{Binding Source={StaticResource NavigationGroups}}"
                         SelectedItem="{Binding SelectedFolderFilter}" AutomationProperties.Name="Navegação do cofre"
                         BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,13,0,5" Height="24">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" />
                                        <Button HorizontalAlignment="Right" Width="30" MinHeight="24" Padding="0"
                                                AutomationProperties.Name="Nova pasta" ToolTip="Nova pasta (Ctrl+Shift+N)"
                                                Command="{Binding DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Pastas">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource AddGlyph}" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                            <Setter Property="Text" Value="{StaticResource FolderGlyph}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FolderFilterKind.All}">
                                                    <Setter Property="Text" Value="{StaticResource VaultGlyph}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FolderFilterKind.Favorites}">
                                                    <Setter Property="Text" Value="{StaticResource StarGlyph}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FolderFilterKind.Recent}">
                                                    <Setter Property="Text" Value="{StaticResource RecentGlyph}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding NavigationName}" ToolTip="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count, Mode=OneWay}" FontSize="11"
                                           Foreground="{StaticResource SidebarMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Margin="0,11,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExternalVaults}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="8,0,0,4" Height="24">
                        <TextBlock Text="Cofres externos" Style="{StaticResource SectionLabel}" />
                        <Button HorizontalAlignment="Right" Width="30" MinHeight="24" Padding="0"
                                ToolTip="Adicionar ou abrir cofre externo" AutomationProperties.Name="Adicionar ou abrir cofre externo"
                                Click="OnExternalMenu">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </Button.Style>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Criar cofre de rede" Click="OnCreateNetworkVault" />
                                    <MenuItem Header="Configurar cofre no USB" Click="OnCreateUsbVault" />
                                    <MenuItem Header="Abrir cofre por convite" Click="OnJoinNetworkVault" />
                                    <Separator />
                                    <MenuItem Header="Chaves e passkeys" Click="OnPasskeyOptions" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource AddGlyph}" FontSize="12" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExternalVaults.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarButton}" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Label}"
                                        Click="OnOpenExternalVault" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="14" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                    <Setter Property="Text" Value="{StaticResource NetworkGlyph}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUsb}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource UsbGlyph}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Border Background="{StaticResource SidebarSelectedBrush}" Height="1" Margin="5,0,5,10" />
                    <TextBlock Text="Ferramentas" Style="{StaticResource SectionLabel}" Margin="9,0,0,6" />
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding GeneratorCommand}" AutomationProperties.Name="Gerador de senhas" ToolTip="Gerador de senhas (Ctrl+G)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Width="22" HorizontalAlignment="Left" Text="{StaticResource KeyGlyph}" />
                            <TextBlock Text="Gerador de senhas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding SyncCommand}" AutomationProperties.Name="Sincronizar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Width="22" HorizontalAlignment="Left" Text="{StaticResource SyncGlyph}" />
                            <TextBlock Text="Sincronizar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding BackupCommand}" AutomationProperties.Name="Exportar backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Width="22" HorizontalAlignment="Left" Text="{StaticResource BackupGlyph}" />
                            <TextBlock Text="Exportar backup" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="Configurações">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Width="22" HorizontalAlignment="Left" Text="{StaticResource SettingsGlyph}" />
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource SidebarSelectedBrush}" Height="1" Margin="5,11,5,12" />
                    <Grid Margin="6,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource ShieldGlyph}" Foreground="{StaticResource BrandMintBrush}"
                                   FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,2,0,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cofre pessoal" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource SidebarMutedBrush}" FontSize="11">
                                <Run x:Name="EntryCountRun" Text="{Binding TotalEntryCount, Mode=OneWay}" /><Run Text=" no cofre" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cofre" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <Grid Grid.Column="1" MaxWidth="440" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBox x:Name="SearchInput" Background="{StaticResource FieldBrush}" MinHeight="39"
                                 Padding="33,8,68,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding SearchPlaceholder}" ToolTip="Busque por nome, usuário ou site (Ctrl+F)" />
                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource SearchGlyph}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="15" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding SearchPlaceholder}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="34,0,68,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSearch, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Padding="6,2" CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                                IsHitTestVisible="False" Visibility="{Binding HasSearch, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Ctrl+F" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <Button HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource IconButton}"
                                Command="{Binding ClearSearchCommand}" Click="OnClearSearch" ToolTip="Limpar busca" AutomationProperties.Name="Limpar busca"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource CloseGlyph}" FontSize="12" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LockCommand}" Margin="0,0,8,0"
                                ToolTip="Bloquear cofre (Ctrl+L)" AutomationProperties.Name="Bloquear cofre" Width="39" Padding="0">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource LockGlyph}" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" ToolTip="Nova credencial (Ctrl+N)"
                                AutomationProperties.Name="Nova credencial">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource AddGlyph}" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="Nova credencial" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" MinWidth="275" MaxWidth="425" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.25*" MinWidth="355" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1" Padding="17,15,17,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ScopeName}" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ScopeName}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0"
                                                Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource IconButton}" Command="{Binding RenameFolderCommand}" ToolTip="Renomear pasta"
                                                AutomationProperties.Name="Renomear pasta">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource EditGlyph}" FontSize="13" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Command="{Binding DeleteFolderCommand}" ToolTip="Excluir pasta"
                                                AutomationProperties.Name="Excluir pasta">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource DeleteGlyph}" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,10,0,0">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                              DisplayMemberPath="Label" AutomationProperties.Name="Ordenar credenciais"
                                              ToolTip="Ordenar credenciais" MinWidth="114" Padding="8,4" MinHeight="29" />
                                    <TextBlock Text="{Binding ResultsLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="EntryList" Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                                 ItemContainerStyle="{StaticResource EntryItem}" BorderThickness="0" Background="Transparent"
                                 AutomationProperties.Name="Credenciais" Padding="8,7"
                                 KeyboardNavigation.TabNavigation="Once" MouseDoubleClick="OnEntryDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSurfaceBrush}">
                                            <TextBlock Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Text="{StaticResource KeyGlyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Username}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="{StaticResource StarFilledGlyph}"
                                                   Foreground="{StaticResource FavoriteBrush}" FontSize="13" Margin="0,0,1,0"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,10"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Center">
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="21">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                            <Setter Property="Text" Value="{StaticResource VaultGlyph}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSearch}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource SearchGlyph}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding EmptyDescription}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            <Button Content="Adicionar credencial" Style="{StaticResource SecondaryButton}" Command="{Binding AddCommand}"
                                    HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="{Binding ShowCreateFromEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Background="{StaticResource FieldBrush}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource KeyGlyph}" Foreground="{StaticResource MutedBrush}" FontSize="21" />
                            </Border>
                            <TextBlock Text="Detalhes da credencial" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="Os dados da credencial selecionada aparecem aqui."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1" Padding="23,9">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}"
                                                ToolTip="{Binding FavoriteActionLabel}" AutomationProperties.Name="{Binding FavoriteActionLabel}" Margin="0,0,7,0">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                        <Setter Property="Text" Value="{StaticResource StarGlyph}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedEntry.IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource StarFilledGlyph}" />
                                                                <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" MinHeight="34" Padding="10,5"
                                                AutomationProperties.Name="Editar credencial">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource EditGlyph}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Editar" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Detalhes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="23,21,23,10">
                                    <Grid Margin="0,0,0,21">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border Width="55" Height="55" CornerRadius="12" Background="{StaticResource AccentSurfaceBrush}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Text="{StaticResource KeyGlyph}" FontSize="23" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedEntryFolderName}" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedEntryFolderName}" Margin="1,3,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14" Visibility="{Binding HasUsername, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Usuário ou e-mail" />
                                                    <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedEntry.Username}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CopyUsernameCommand}"
                                                        ToolTip="Copiar usuário" AutomationProperties.Name="Copiar usuário">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource CopyGlyph}" FontSize="14" />
                                                </Button>
                                            </Grid>
                                            <Grid Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Senha" />
                                                    <TextBlock Style="{StaticResource DetailValue}" Text="{Binding PasswordDisplay}" FontFamily="Consolas" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding TogglePasswordCommand}"
                                                            ToolTip="{Binding PasswordActionLabel}" AutomationProperties.Name="{Binding PasswordActionLabel}">
                                                        <TextBlock FontSize="14">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                                    <Setter Property="Text" Value="{StaticResource ShowGlyph}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                                            <Setter Property="Text" Value="{StaticResource HideGlyph}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyPasswordCommand}"
                                                            ToolTip="Copiar senha" AutomationProperties.Name="Copiar senha">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource CopyGlyph}" FontSize="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,14,0,0" Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource LabelText}" Text="Site" />
                                                    <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedEntry.Website}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CopyWebsiteCommand}"
                                                        ToolTip="Copiar endereço do site" AutomationProperties.Name="Copiar endereço do site">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource CopyGlyph}" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="1,18,1,0" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource LabelText}" Text="Notas" />
                                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedEntry.Notes}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,18,1,4" TextWrapping="Wrap">
                                        <Run Text="Atualizada em " /><Run Text="{Binding UpdatedLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
                                <Button HorizontalAlignment="Right" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" MinHeight="33" Padding="8,5"
                                        AutomationProperties.Name="Excluir credencial">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource DeleteGlyph}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Excluir credencial" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0">
                    <TextBlock DockPanel.Dock="Right" Text="Bloqueio automático em 5 min" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
