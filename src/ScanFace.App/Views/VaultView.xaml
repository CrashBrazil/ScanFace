<UserControl x:Class="ScanFace.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="White" CornerRadius="10" Padding="7">
                        <Image Source="/Assets/scanface-logo.png" Height="86" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="COFRE PESSOAL" Foreground="#8FA7C3" FontSize="11" FontWeight="Bold" Margin="4,28,0,10" />
                    <Border Background="#112B50" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" Foreground="{StaticResource CyanBrush}" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="Credenciais" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="5,12,0,0" Foreground="#8FA7C3">
                        <Run x:Name="EntryCountRun" Text="{Binding EntryCount, Mode=OneWay}" /><Run Text=" itens protegidos" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Configurações" Command="{Binding SettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                    <Button Content="Bloquear cofre" Command="{Binding LockCommand}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Bloqueio automático: 5 min" Foreground="#8FA7C3" FontSize="11" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Minhas credenciais" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Dados cifrados localmente com AES-256-GCM" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Sincronizar" Command="{Binding SyncCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Exportar backup" Command="{Binding BackupCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="+ Nova credencial" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,22,0,16"
                     ToolTip="Pesquisar por nome, usuário ou site" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.2*" MinWidth="350" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#E6F4FC">
                                            <TextBlock Text="●" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Username}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="★" Foreground="#F4B740" FontSize="18"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="◇" FontSize="36" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Seu cofre está vazio" FontWeight="SemiBold" FontSize="17" Margin="0,8,0,4" />
                            <TextBlock Text="Adicione sua primeira credencial." Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="Selecione uma credencial para ver os detalhes." Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel DataContext="{Binding SelectedEntry}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Website}" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,22" TextWrapping="Wrap" />

                            <TextBlock Text="USUÁRIO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding Username}" FontSize="15" Margin="0,4,0,18" TextWrapping="Wrap" />
                            <TextBlock Text="SENHA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="••••••••••••" FontSize="17" Margin="0,4,0,18" />
                            <TextBlock Text="NOTAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding Notes}" Margin="0,4,0,20" TextWrapping="Wrap" MaxHeight="110" />
                            <TextBlock Text="{Binding UpdatedAtUtc, StringFormat=Atualizado em {0:dd/MM/yyyy HH:mm}}" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                            <WrapPanel Margin="0,24,0,0">
                                <Button Content="Copiar usuário" Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Copiar senha" Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="Editar" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Excluir" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
