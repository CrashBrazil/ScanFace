<Window x:Class="ScanFace.App.Views.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/ScanFace;component/Assets/scanface.ico">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,15" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Nome da pasta" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Nome da pasta" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormStatus}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}"
                    MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
