<Window x:Class="ScanFace.App.Views.PasskeyOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Chaves e passkeys" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="23">
        <TextBlock Text="Chaves e passkeys" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Border Style="{StaticResource Card}" Padding="17">
            <StackPanel>
                <TextBlock Text="Pendrive com cofre ScanFace" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Abra suas credenciais com o pendrive configurado e a senha do cofre."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" />
                <TextBlock Text="Chave de segurança FIDO2" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Use um autenticador FIDO2 para cadastrar uma chave física no Google. O Windows gerencia o PIN da chave e o Google gerencia o cadastro na conta."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13" />
                <WrapPanel>
                    <Button Content="Gerenciar chave no Windows" Style="{StaticResource SecondaryButton}" Click="OpenWindowsClick" Margin="0,0,5,5" />
                    <Button Content="Configurar no Google" Style="{StaticResource SecondaryButton}" Click="OpenGoogleClick" Margin="0,0,0,5" />
                </WrapPanel>
                <TextBlock x:Name="Status" Style="{StaticResource FormStatus}" />
            </StackPanel>
        </Border>
        <Button Content="Fechar" IsCancel="True" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</Window>
