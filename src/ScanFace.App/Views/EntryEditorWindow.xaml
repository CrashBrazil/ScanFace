<Window x:Class="ScanFace.App.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Style="{StaticResource AppWindow}" Title="{Binding Title}" Width="700" Height="745" MinWidth="560" MinHeight="570"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Icon="/ScanFace;component/Assets/scanface.ico">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource AccentSurfaceBrush}">
                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource KeyGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="20" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificação" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nome" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da credencial" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pasta" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Pasta" MinHeight="42" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Marcar como favorito" IsChecked="{Binding IsFavorite}" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Dados de acesso" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Usuário ou e-mail" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuário ou e-mail" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Site" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Site" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Senha" Style="{StaticResource LabelText}" Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding Password}"
                                         PasswordChanged="PasswordChanged" AutomationProperties.Name="Senha"
                                         Visibility="{Binding RevealPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Senha"
                                     Visibility="{Binding RevealPassword, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Column="1" Content="Gerar senha" Command="{Binding GeneratePasswordCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </Grid>
                        <CheckBox Content="Mostrar senha" IsChecked="{Binding RevealPassword}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding GeneratorErrorMessage}" Style="{StaticResource FormStatus}" />

                        <Expander Header="Opções do gerador" Margin="0,11,0,0">
                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Comprimento (5 a 128)" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding GeneratorLength, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center" AutomationProperties.Name="Comprimento" />
                                    </Grid>

                                    <TextBlock Text="Incluir" Style="{StaticResource LabelText}" Margin="0,10,0,6" />
                                    <WrapPanel>
                                        <CheckBox Content="A-Z" IsChecked="{Binding IncludeUppercase}" Margin="0,0,18,6" />
                                        <CheckBox Content="a-z" IsChecked="{Binding IncludeLowercase}" Margin="0,0,18,6" />
                                        <CheckBox Content="0-9" IsChecked="{Binding IncludeNumbers}" Margin="0,0,18,6" />
                                        <CheckBox Content="!@#$" IsChecked="{Binding IncludeSymbols}" Margin="0,0,0,6" />
                                    </WrapPanel>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mínimo de números" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding MinimumOptions}" SelectedItem="{Binding MinimumNumbers}"
                                                      AutomationProperties.Name="Mínimo de números" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mínimo de símbolos" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding MinimumOptions}" SelectedItem="{Binding MinimumSymbols}"
                                                      AutomationProperties.Name="Mínimo de símbolos" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Evitar caracteres ambíguos (I, l, 1, O, 0, o)"
                                              IsChecked="{Binding AvoidAmbiguousCharacters}" Margin="0,12,0,0" />
                                    <Button Content="Gerar com estas opções" Command="{Binding GeneratePasswordCommand}"
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Notas" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" MaxHeight="180" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Notas" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormStatus}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" MinWidth="86" Margin="0,0,8,0" />
                <Button Content="Salvar" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="96" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
