<Window x:Class="ScanFace.App.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Title="{Binding Title}" Width="640" Height="820" MinWidth="560" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Icon="/Assets/scanface-logo.png">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="O conteúdo deste item será cifrado antes de chegar ao banco local."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Nome" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Usuário ou e-mail" FontWeight="SemiBold" Margin="0,14,0,5" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,14,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding Password}"
                                 PasswordChanged="PasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                <Style.Triggers><DataTrigger Binding="{Binding RevealPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding RevealPassword}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="Gerar" Command="{Binding GeneratePasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                </Grid>
                <CheckBox Content="Mostrar senha" IsChecked="{Binding RevealPassword}" Margin="0,8,0,0" />

                <Expander Header="Personalizar senha gerada" IsExpanded="False" Margin="0,14,0,0">
                    <Border Background="#F7FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Comprimento (5 a 128)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding GeneratorLength, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Incluir" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <WrapPanel>
                                <CheckBox Content="A-Z" IsChecked="{Binding IncludeUppercase}" Margin="0,0,18,6" />
                                <CheckBox Content="a-z" IsChecked="{Binding IncludeLowercase}" Margin="0,0,18,6" />
                                <CheckBox Content="0-9" IsChecked="{Binding IncludeNumbers}" Margin="0,0,18,6" />
                                <CheckBox Content="!@#$" IsChecked="{Binding IncludeSymbols}" Margin="0,0,0,6" />
                            </WrapPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mínimo de números" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding MinimumOptions}" SelectedItem="{Binding MinimumNumbers}" MinHeight="38" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mínimo de símbolos" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding MinimumOptions}" SelectedItem="{Binding MinimumSymbols}" MinHeight="38" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Evitar caracteres ambíguos (I, l, 1, O, 0, o)"
                                      IsChecked="{Binding AvoidAmbiguousCharacters}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding GeneratorErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Button Content="Gerar com estas opções" Command="{Binding GeneratePasswordCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>

                <TextBlock Text="Site" FontWeight="SemiBold" Margin="0,14,0,5" />
                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Notas" FontWeight="SemiBold" Margin="0,14,0,5" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

                <CheckBox Content="Marcar como favorito" IsChecked="{Binding IsFavorite}" Margin="0,14,0,8" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
