<Window x:Class="ScanFace.App.Views.ExternalVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Width="900" Height="640" MinWidth="710" MinHeight="510"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/ScanFace;component/Assets/scanface.ico"
        Closed="OnClosed" Deactivated="OnDeactivated">
    <Grid Margin="23,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="45" Height="45" CornerRadius="9" Background="{StaticResource AccentSurfaceBrush}">
                <TextBlock x:Name="KindIcon" Style="{StaticResource Glyph}" FontSize="21" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,8,0">
                <TextBlock x:Name="VaultTitle" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Subtitle" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="EditActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Nova pasta" Style="{StaticResource SecondaryButton}" Click="AddFolderClick" Margin="0,0,6,0" />
                <Button Content="Nova credencial" Style="{StaticResource PrimaryButton}" Click="AddEntryClick" />
            </StackPanel>
        </Grid>
        <Border x:Name="Publishing" Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="CopyInvitation" Content="Copiar convite" Style="{StaticResource QuietButton}" Click="CopyInvitationClick" />
                    <Button Content="Configurar" Style="{StaticResource SecondaryButton}" Click="ConfigureClick" Margin="0,0,5,0" />
                    <Button x:Name="ShareButton" Style="{StaticResource PrimaryButton}" Click="ShareClick" />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShareState" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShareCode" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <ComboBox x:Name="Folders" DockPanel.Dock="Top" DisplayMemberPath="Name" SelectionChanged="FolderChanged"
                              AutomationProperties.Name="Filtrar por pasta" Margin="0,0,0,7" />
                    <ListBox x:Name="Items" DisplayMemberPath="Name" BorderThickness="0" SelectionChanged="EntryChanged"
                             AutomationProperties.Name="Credenciais deste cofre" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <TextBlock x:Name="NoSelection" Text="Escolha uma credencial para ver os detalhes." Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="EntryName" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" />
                            <TextBlock Text="Usuário" Style="{StaticResource LabelText}" Margin="0,13,0,3" />
                            <TextBlock x:Name="EntryUsername" TextWrapping="Wrap" />
                            <TextBlock Text="Senha" Style="{StaticResource LabelText}" Margin="0,11,0,3" />
                            <TextBlock x:Name="EntryPassword" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="Site" Style="{StaticResource LabelText}" Margin="0,11,0,3" />
                            <TextBlock x:Name="EntrySite" TextWrapping="Wrap" />
                            <TextBlock Text="Notas" Style="{StaticResource LabelText}" Margin="0,11,0,3" />
                            <TextBlock x:Name="EntryNotes" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Copiar usuário" Style="{StaticResource SecondaryButton}" Click="CopyUserClick" Margin="0,0,5,5" />
                                <Button Content="Copiar senha" Style="{StaticResource SecondaryButton}" Click="CopyPasswordClick" Margin="0,0,5,5" />
                                <Button x:Name="RevealPassword" Content="Mostrar senha" Style="{StaticResource QuietButton}" Click="RevealClick" Margin="0,0,5,5" />
                                <Button x:Name="EditEntry" Content="Editar" Style="{StaticResource QuietButton}" Click="EditEntryClick" Margin="0,0,5,5" />
                                <Button x:Name="DeleteEntry" Content="Excluir" Style="{StaticResource DangerButton}" Click="DeleteEntryClick" Margin="0,0,5,5" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,13,0,0">
            <WrapPanel x:Name="TransferActions" DockPanel.Dock="Right">
                <Button x:Name="ImportItems" Content="Importar de…" Style="{StaticResource SecondaryButton}" Click="ImportClick" Margin="0,0,5,0" />
                <Button Content="Copiar para…" Style="{StaticResource PrimaryButton}" Click="ExportClick" Margin="0,0,5,0" />
                <Button Content="Fechar" Style="{StaticResource QuietButton}" IsCancel="True" />
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,5,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
