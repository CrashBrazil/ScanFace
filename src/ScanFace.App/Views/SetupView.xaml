<UserControl x:Class="ScanFace.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:ScanFace.App.Presentation">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="24">
            <Border Width="520" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Background="White" CornerRadius="10" Padding="12" HorizontalAlignment="Center">
                        <Image Source="/Assets/scanface-logo.png" Width="250" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Crie seu cofre protegido" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                    <TextBlock Text="Seus dados são cifrados neste computador antes de serem salvos ou sincronizados."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="20,0,20,24" />

                    <TextBlock Text="Senha mestra" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding MasterPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Use pelo menos 12 caracteres. O ScanFace nunca armazena essa senha."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" />

                    <TextBlock Text="Confirme a senha mestra" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox IsChecked="{Binding EnableWindowsHello}" Margin="0,18,0,4" FontWeight="SemiBold"
                              Content="Permitir desbloqueio sem a senha mestra usando o Windows Hello" />
                    <TextBlock Text="O Windows decide se usará rosto, impressão digital ou PIN conforme a configuração deste dispositivo."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="22,0,0,18" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="Criar cofre" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" />

                    <Grid Margin="0,20,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="ou" Foreground="{StaticResource MutedBrush}" Margin="12,0" />
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Button Content="Restaurar backup cifrado" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
