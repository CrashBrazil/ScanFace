<UserControl x:Class="ScanFace.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:ScanFace.App.Presentation">
    <ContentControl Style="{StaticResource AuthFrame}">
        <StackPanel>
            <TextBlock Text="Criar seu cofre" FontSize="29" FontWeight="SemiBold" />
            <TextBlock Text="Defina uma senha mestra para proteger suas credenciais." Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,18" />
            <Label x:Name="MasterPasswordLabel" Content="Senha mestra" Style="{StaticResource FormLabel}"
                   Target="{Binding ElementName=MasterPasswordInput}" Margin="0,0,0,6" />
            <PasswordBox x:Name="MasterPasswordInput" AutomationProperties.LabeledBy="{Binding ElementName=MasterPasswordLabel}"
                         presentation:PasswordBoxHelper.BoundPassword="{Binding MasterPassword}" PasswordChanged="MasterPasswordChanged" />
            <TextBlock Text="Use pelo menos 12 caracteres." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,11" />
            <Label x:Name="ConfirmPasswordLabel" Content="Confirmar senha mestra" Style="{StaticResource FormLabel}"
                   Target="{Binding ElementName=ConfirmPasswordInput}" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmPasswordInput" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPasswordLabel}"
                         presentation:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword}" PasswordChanged="ConfirmPasswordChanged" />
            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,13,0,0">
                <StackPanel>
                    <CheckBox IsChecked="{Binding EnableWindowsHello}" Content="Desbloquear com Windows Hello" FontWeight="SemiBold" />
                    <TextBlock Text="Use rosto, impressão digital ou PIN, conforme a configuração deste dispositivo."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FormStatus}" />
            <Button Content="Criar cofre" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" MinHeight="42" Margin="0,13,0,0" />
            <Button Content="Restaurar backup cifrado" Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}"
                    Margin="0,5,0,0" />
        </StackPanel>
    </ContentControl>
</UserControl>
