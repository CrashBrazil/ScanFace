<Window x:Class="ScanFace.App.Views.BackupImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Title="Restaurar backup ScanFace" Width="480" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/Assets/scanface-logo.png">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Restaurar cofre cifrado" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="A senha mestra do backup é necessária uma vez para validar e abrir a chave do cofre."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,20" />
            <TextBlock Text="Senha mestra do backup" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Ativar Windows Hello neste computador" IsChecked="{Binding EnableWindowsHello}" Margin="0,16,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Restaurar" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
