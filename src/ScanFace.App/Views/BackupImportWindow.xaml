<Window x:Class="ScanFace.App.Views.BackupImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Title="Restaurar backup ScanFace" Width="505" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="/ScanFace;component/Assets/scanface.ico">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Restaurar backup" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Use a senha mestra do backup para abrir o cofre."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,20" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Senha mestra do backup" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding Password}" PasswordChanged="PasswordChanged"
                             AutomationProperties.Name="Senha mestra do backup" />
                <CheckBox Content="Ativar Windows Hello neste computador" IsChecked="{Binding EnableWindowsHello}" Margin="0,13,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormStatus}" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="Restaurar" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
