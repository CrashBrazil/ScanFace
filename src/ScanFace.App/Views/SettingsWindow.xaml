<Window x:Class="ScanFace.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Title="Configurações do ScanFace" Width="675" Height="725" MinWidth="550" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Icon="/ScanFace;component/Assets/scanface.ico">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource AccentSurfaceBrush}">
                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource SettingsGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="20" />
            </Border>
            <TextBlock Grid.Column="1" Text="Configurações" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Windows Hello" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Permite abrir o cofre neste perfil do Windows sem digitar a senha mestra."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <CheckBox IsChecked="{Binding WindowsHelloEnabled}" Content="Ativar desbloqueio pelo Windows Hello" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Sincronização opcional" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="A API recebe somente o snapshot cifrado. Deixe os campos vazios para trabalhar apenas offline."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="URL da API" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="URL da API" />
                        <TextBlock Text="Token da API" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding ApiToken}"
                                     PasswordChanged="ApiTokenChanged" AutomationProperties.Name="Token da API" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Trocar senha mestra" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Como o cofre já está desbloqueado, você pode definir uma nova senha mesmo tendo entrado com o rosto."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="Nova senha (mínimo de 12 caracteres)" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding NewMasterPassword}"
                                     PasswordChanged="NewMasterPasswordChanged" AutomationProperties.Name="Nova senha mestra" />
                        <TextBlock Text="Confirmar nova senha" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding ConfirmMasterPassword}"
                                     PasswordChanged="ConfirmMasterPasswordChanged" AutomationProperties.Name="Confirmar nova senha mestra" />
                        <Button Content="Alterar senha mestra" Command="{Binding ChangeMasterPasswordCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Fechar" Command="{Binding CloseCommand}" Style="{StaticResource QuietButton}" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
