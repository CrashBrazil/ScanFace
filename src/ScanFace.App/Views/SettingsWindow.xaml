<Window x:Class="ScanFace.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:ScanFace.App.Presentation"
        Title="Configurações do ScanFace" Width="650" Height="690" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Icon="/Assets/scanface-logo.png">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Configurações" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Biometria, sincronização zero knowledge e senha mestra."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Windows Hello" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Permite abrir o cofre neste perfil do Windows sem digitar a senha mestra."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <CheckBox IsChecked="{Binding WindowsHelloEnabled}" Content="Ativar desbloqueio pelo Windows Hello" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Sincronização opcional" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="A API recebe somente o snapshot cifrado. Deixe os campos vazios para trabalhar apenas offline."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="URL da API" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Token da API" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding ApiToken, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Trocar senha mestra" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Como o cofre já está desbloqueado, você pode definir uma nova senha mesmo tendo entrado com o rosto."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="Nova senha (mínimo de 12 caracteres)" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding NewMasterPassword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Confirmar nova senha" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <PasswordBox presentation:PasswordBoxHelper.BoundPassword="{Binding ConfirmMasterPassword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Alterar senha mestra" Command="{Binding ChangeMasterPasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Fechar" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
