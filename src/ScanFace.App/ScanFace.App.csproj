<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\scanface.ico</ApplicationIcon>
    <AssemblyName>ScanFace</AssemblyName>
    <RootNamespace>ScanFace.App</RootNamespace>
    <Version>1.0.2</Version>
    <Authors>GiorgioRafael</Authors>
    <Product>ScanFace</Product>
    <Description>Cofre de senhas zero knowledge com desbloqueio pelo Windows Hello.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanFace.Domain\ScanFace.Domain.csproj" />
    <ProjectReference Include="..\ScanFace.Application\ScanFace.Application.csproj" />
    <ProjectReference Include="..\ScanFace.Infrastructure\ScanFace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\scanface-logo.png" />
    <Resource Include="Assets\scanface.ico" />
  </ItemGroup>

</Project>
